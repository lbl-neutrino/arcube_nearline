#!/usr/bin/env bash

## Example command to submit this job:
# justin simple-workflow \
#     --wall-seconds 1200 \
#     --image fnal-wn-el9:9.7 \
#     --mql "files from dune:all where core.run_type=neardet-2x2-lar-light and core.application.name=flow and core.runs=70011 limit 1" \
#     --env ND_NEARLINE_SCRIPTS_DIR=$ND_NEARLINE_SCRIPTS_DIR \
#     --jobscript light_dqm.jobscript

set -euo pipefail
source "$ND_NEARLINE_SCRIPTS_DIR/ndproto_nearline/justin/setup.inc.sh"

# xrdcp "$pfn" .

file_syntax=$(basename "$input_fname" ".$ND_NEARLINE_TAG.FLOW.hdf5" | sed 's/[0-9]\+$//')
start_run=$(basename "$input_fname" ".$ND_NEARLINE_TAG.FLOW.hdf5" | sed -n 's/.*[^0-9]\([0-9]\+\)$/\1/p')
echo "Starting run with p$start_run"

cd "$scripts_dir/ndproto_nearline/actions/light_dqm"

channel_status=$PWD/channel_status_warmRun2.csv

plotdir=/home/workspace/plots
tmpdir=/home/workspace/tmp
mkdir -p "$plotdir" "$tmpdir"

# light_dqm.py expects the trailing slash on input_path
# python3 light_dqm.py --input_path "/home/workspace/" \
#                      --output_dir "$plotdir" \
#                      --tmp_dir "$tmpdir" \
#                      --file_syntax "$file_syntax" \
#                      --channel_status_file "$channel_status" \
#                      --start_run "$start_run"

auth=(--cert "$X509_USER_PROXY" --key "$X509_USER_PROXY" --cacert $env_dir/env/ssl/cacert.pem --capath /etc/grid-security/certificates)
ls -l /etc/pki/tls/certs/ca-bundle.crt
ls -ld /etc/grid-security/certificates

echo hello > $plotdir/foo.pdf

for plot in "$plotdir"/*.pdf; do
    curl "${auth[@]}" --upload-file "$plot" "https://labpix.lbl.gov:55556/light_dqm/$(basename "$plot")"
done
