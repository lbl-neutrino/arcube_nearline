#!/usr/bin/env bash

## Example command to submit this job:
# justin simple-workflow \
#     --wall-seconds 1200 \
#     --output-pattern '*.PACKET.hdf5' \
#     --scope usertests \
#     --lifetime-days 7 \
#     --image fnal-wn-el9:9.7 \
#     --mql "files from vd-coldbox-pixels:vd_coldbox_pixels_1 where core.application.name=crs_daq limit 1" \
#     --env ND_NEARLINE_TAG=test \
#     --env ND_NEARLINE_SCRIPTS_DIR=$ND_NEARLINE_SCRIPTS_DIR \
#     --jobscript packetize_charge_data.jobscript

## Example command to test this job:
# justin-test-jobscript.al9 \
#     --mql "files from vd-coldbox-pixels:vd_coldbox_pixels_1 where core.application.name=crs_daq limit 1" \
#     --env ND_NEARLINE_TAG=test \
#     --env ND_NEARLINE_SCRIPTS_DIR=$ND_NEARLINE_SCRIPTS_DIR \
#     --jobscript packetize_charge_data.jobscript


source "$ND_NEARLINE_SCRIPTS_DIR/ndproto_nearline/justin/setup.inc.sh"

output_fname=$(basename "$input_fname" .hdf5).${ND_NEARLINE_TAG}.PACKET.hdf5

python "$(which metacat)" file show -mj "$did" > "${input_fname}.json"

xrdcp "$pfn" .
input_file=$PWD/$input_fname
output_file=$PWD/$output_fname

python $(which convert_rawhdf5_to_hdf5.py) \
    --input_filename "$input_file" --output_filename "$output_file" \
    --asic-version 1:2,2:2,3:3,4:3,5:2,6:2 \
    --format-version 3.0 --direct

python $scripts_dir/ndproto_nearline/justin/dump_metadata.charge_packet.py \
    "${input_fname}.json" "${output_fname}"

echo "$did" > /home/workspace/justin-processed-dids.txt
