#!/bin/bash

did_pfn_rse=$("$JUSTIN_PATH/justin-get-file")

if [[ $? != 0 ]]; then
    echo "Got nothing from justin-get-file; bailing"
    exit
fi

did=$(echo "$did_pfn_rse" | cut -f1 -d' ')
pfn=$(echo "$did_pfn_rse" | cut -f2 -d' ')

tar_spack=/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/8c80e4bba3a3e4f49e84c980d0f9054a2add653c/spack_cache.tar
tar_venv=/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/8c80e4bba3a3e4f49e84c980d0f9054a2add653c/nearline_venv.tar
tar_scripts=/cvmfs/fifeuser3.opensciencegrid.org/sw/dune/8c80e4bba3a3e4f49e84c980d0f9054a2add653c/arcube_nearline.tar
dir_flow=/cvmfs/fifeuser1.opensciencegrid.org/sw/dune/e1f0176a8e8903d940532bd461a20a36f688ab06/ndlar_flow

tar xf "$tar_spack"             # creates spack_cache
tar xf "$tar_venv"              # creates nearline.venv
tar xf "$tar_scripts"           # creates arcube_nearline
cp -r "$dir_flow" .             # creates ndlar_flow

source /cvmfs/dune.opensciencegrid.org/spack/v1.1.1/setup-env.sh
export SPACK_USER_CACHE_DIR=$PWD/spack_cache
date
spack env activate dunesw-10_21_01d00-justin-01_06_01-prototype
date

ND_NEARLINE_TAG=${ND_NEARLINE_TAG:-test}
input_fname=$(echo "$did" | cut -f2 -d:)
output_fname=$(basename "$input_fname" .data).${ND_NEARLINE_TAG}.FLOW.hdf5

ifdh cp "$pfn" .
metacat file show -mj "$did" > "${input_fname}.json"

date
spack env deactivate
date
spack load python@3.14.3/mkwcary
date
source nearline.venv/bin/activate

# FIXME: Switch to Run3 yaml
workflow='yamls/proto_nd_flow/workflows/light/light_event_building_mpd.yaml'

(
  cd ndlar_flow || exit
  h5flow -c "$workflow" -i "../$input_fname" -o "../$output_fname"
)

python arcube_nearline/justin/dump_metadata.light_flow.py \
    "${input_fname}.json" "${output_fname}"

echo "$did" > justin-processed-dids.txt
