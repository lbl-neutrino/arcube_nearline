#!/usr/bin/env bash

## Example command to submit this job:
# justin simple-workflow \
#     --wall-seconds 1200 \
#     --output-pattern '*.hdf5' \
#     --scope usertests \
#     --lifetime-days 7 \
#     --image fnal-wn-el9:9.7 \
#     --mql "files from neardet-2x2-lar-light:neardet-2x2-lar-light_70011 limit 1" \
#     --env ND_NEARLINE_TAG=test_simple_noStream \
#     --jobscript flow_light_data.jobscript

set -euo pipefail

did_pfn_rse=$("$JUSTIN_PATH/justin-get-file")
result=$?
if [[ $result != 0 ]]; then
    echo "Got nothing from justin-get-file; bailing"
    exit
fi
echo "$did_pfn_rse"
did=$(echo "$did_pfn_rse" | cut -f1 -d' ')
pfn=$(echo "$did_pfn_rse" | cut -f2 -d' ')

env_dir=/cvmfs/fifeuser2.opensciencegrid.org/sw/dune/8feba1e3710c16e0743be5f75cf20fab531e9f95
export PATH=$env_dir/env/bin:$PATH
export LD_LIBRARY_PATH=$env_dir/env/lib:$LD_LIBRARY_PATH
export LD_PRELOAD=$env_dir/env/lib/libXrdPosixPreload.so:$LD_PRELOAD
export METACAT_SERVER_URL=https://metacat.fnal.gov:9443/dune_meta_prod/app
export METACAT_AUTH_SERVER_URL=https://metacat.fnal.gov:8143/auth/dune

scripts_dir=/cvmfs/fifeuser2.opensciencegrid.org/sw/dune/592f8f2efa38a2c5c545b09c449a7f9b3454b077

ND_NEARLINE_TAG=${ND_NEARLINE_TAG:-test}
input_fname=$(echo "$did" | cut -f2 -d:)
output_fname=$(basename "$input_fname" .data).${ND_NEARLINE_TAG}.FLOW.hdf5

python "$(which metacat)" file show -mj "$did" > "${input_fname}.json"
ls -l

# Run3 is using _Run2.yaml
workflow='yamls/proto_nd_flow/workflows/light/light_event_building_mpd_Run2.yaml'

xrdcp "$pfn" .
input_file=$PWD/$input_fname
output_file=$PWD/$output_fname

# pushd $env_dir/ndlar_flow
pushd /cvmfs/fifeuser4.opensciencegrid.org/sw/dune/10bba04d514dee870f62ce342ca5dddeace41a9a/ndlar_flow
python -m h5flow -c "$workflow" -i "$input_file" -o "$output_file"
popd

python $scripts_dir/ndproto_nearline/justin/dump_metadata.light_flow.py \
    "${input_fname}.json" "${output_fname}"

echo "$did" > justin-processed-dids.txt
