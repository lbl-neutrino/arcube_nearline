#!/bin/bash

## Example command to submit this job:
# justin simple-workflow \
#     --wall-seconds 1200 \
#     --output-pattern '*.hdf5' \
#     --scope usertests \
#     --lifetime-days 7 \
#     --image fnal-wn-el9:9.7 \
#     --mql "files from neardet-2x2-lar-light:neardet-2x2-lar-light_50017 limit 1" \
#     --env ND_NEARLINE_TAG=test_simple \
#     --jobscript flow_light_data.jobscript

did_pfn_rse=$("$JUSTIN_PATH/justin-get-file")

if [[ $? != 0 ]]; then
    echo "Got nothing from justin-get-file; bailing"
    exit
fi

did=$(echo "$did_pfn_rse" | cut -f1 -d' ')
pfn=$(echo "$did_pfn_rse" | cut -f2 -d' ')

env_dir=/cvmfs/fifeuser4.opensciencegrid.org/sw/dune/10bba04d514dee870f62ce342ca5dddeace41a9a
scripts_dir=/cvmfs/fifeuser4.opensciencegrid.org/sw/dune/d299877c1a74d42e1d95eb9b10cced0d0f52bbef/ndproto_nearline

ND_NEARLINE_TAG=${ND_NEARLINE_TAG:-test}
input_fname=$(echo "$did" | cut -f2 -d:)
output_fname=$(basename "$input_fname" .data).${ND_NEARLINE_TAG}.FLOW.hdf5

ifdh cp "$pfn" .
metacat file show -mj "$did" > "${input_fname}.json"

source $env_dir/activate.sh

# FIXME: Switch to Run3 yaml
workflow='yamls/proto_nd_flow/workflows/light/light_event_building_mpd.yaml'

input_file=$(realpath "$input_fname")
output_file=$(realpath "$output_fname")

pushd $env_dir/ndlar_flow
h5flow -c "$workflow" -i "$(input_file)" -o "$(output_file)"
popd

python $scripts_dir/justin/dump_metadata.light_flow.py \
    "${input_fname}.json" "${output_fname}"

echo "$did" > justin-processed-dids.txt
